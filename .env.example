# MAIA — environment template. Copy to `.env` (git-ignored) and fill in.
# Secrets are PO-custodied and NEVER committed. CI reads them from GitHub Secrets.
# Operational tooling per provider lives in 01-TOOLS/ (local/Drive, out of git).

# Hugging Face — write token (dataset/model upload, gated Gemma download).
HF_TOKEN=

# GPU provider — RunPod (or Vast.ai) API key for rented A100/H100 training.
RUNPOD_API_KEY=

# Frontier LLM — generator + LLM-as-judge for the synthetic dataset (Claude / Gemini).
LLM_API_KEY=

# Weights & Biases — training run tracking.
WANDB_API_KEY=

# Gemma base model — pinned once M0.05 verifies the download.
GEMMA_MODEL_ID=google/gemma-4-12b-it
GEMMA_REVISION=

# Qdrant — RAG vector store (local docker or managed).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
