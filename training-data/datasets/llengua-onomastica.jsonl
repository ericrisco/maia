{"id": "llengua-onomastica/els-gentilicis/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Fes-me una llista dels gentilicis de les set parròquies andorranes, amb les formes masculina i femenina quan s’indiquen."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/els-gentilicis.md"]}
{"id": "llengua-onomastica/els-gentilicis/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica per què de Sant Julià de Lòria se’n diu lauredià i quin origen té aquesta forma."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/els-gentilicis.md"]}
{"id": "llengua-onomastica/els-gentilicis/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Aclareix quin conflicte hi ha entre les grafies «la Maçana» i «la Massana» i quina forma s’ha oficialitzat al país."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/els-gentilicis.md"]}
{"id": "llengua-onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix la diferència entre el nom oficial d’una persona andorrana i el nom que feia servir la gent a la vida diària el 1904."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom.md"]}
{"id": "llengua-onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica com passava el nom de casa de pare a hereu quan el cap de casa moria."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom.md"]}
{"id": "llengua-onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Descriu com s’anomenaven el pare vell, l’hereu, la seva dona i el germà de l’hereu mentre convivien dins la casa Moles."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom.md"]}
{"id": "llengua-onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Aclareix què volen dir «pubilla» i «pubill» en el cas d’una hereva i del seu marit."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom.md"]}
{"id": "llengua-onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom/05", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Enumera els diminutius de noms de pila i els renoms que es registren per a Andorra a començament del segle XX."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom.md"]}
{"id": "llengua-onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom/06", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica per què un mateix mot pot identificar una casa en un poble i ser el nom d’una família en un altre."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom.md"]}
{"id": "llengua-onomastica/onomastica/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Ajuda’m a entendre per què el nom de casa podia identificar una persona millor que el cognom a Andorra."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/onomastica.md"]}
{"id": "llengua-onomastica/onomastica/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica com el paper polític del cap de casa va reforçar la relació entre la casa i la identitat familiar."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/onomastica.md"]}
{"id": "llengua-onomastica/onomastica/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix quins aspectes de l’onomàstica andorrana encara queden per conèixer en l’ús actual."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/onomastica.md"]}
{"id": "llengua-onomastica/relacio/01", "type": "relacio", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Compara el nom de casa com a forma d’identificació quotidiana amb el seu paper polític abans i després de la Nova Reforma."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/onomastica.md", "docs/temes/llengua/onomastica/lhereu-pren-el-seu-lloc-i-el-seu-nom.md"]}
{"id": "llengua-onomastica/relacio/02", "type": "relacio", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Relaciona els gentilicis de les parròquies amb la manera com els noms de casa distingien les persones; explica per què cap de les dues formes s’hauria de deduir mecànicament del topònim o del cognom."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/onomastica/els-gentilicis.md", "docs/temes/llengua/onomastica/onomastica.md"]}
