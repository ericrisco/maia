{"id":"cultura-artesania/el-ferro/01","type":"directa","messages":[{"role":"system","content":""},{"role":"user","content":"Quan va començar i quan va acabar l’època de les fargues a Andorra?"},{"role":"assistant","content":"La primera farga coneguda és del 1619 i l’última, la de Casa Areny, va tancar el 1893."},{"role":"user","content":"I què va fer que l’última tanqués?"},{"role":"assistant","content":""}],"documents":["docs/temes/cultura/artesania/el-ferro.md"]}
