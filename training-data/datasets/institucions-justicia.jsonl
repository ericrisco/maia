{"id": "institucions-justicia/a-les-galeres-despanya-per-la-neu/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Quines raons feien enviar condemnats andorrans a les galeres d'Espanya?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/institucions/justicia/a-les-galeres-despanya-per-la-neu.md"]}
