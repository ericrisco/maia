{"id": "vida-quotidiana-com-funciona-tot/com-funciona-tot/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Per a un tràmit local a Andorra, indica la institució on m’adreço i com n’hi diuen."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/com-funciona-tot.md"]}
{"id": "vida-quotidiana-com-funciona-tot/com-funciona-tot/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Fes-me un petit mapa de les paraules andorranes per a l’autoritat local, el jutjat de primera instància i qui vetlla pels drets de la ciutadania."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/com-funciona-tot.md"]}
{"id": "vida-quotidiana-com-funciona-tot/com-funciona-tot/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Compara una ordinació, un arrest i un cot en l’ús administratiu andorrà."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/com-funciona-tot.md"]}
{"id": "vida-quotidiana-com-funciona-tot/com-funciona-tot/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix com s’organitzen els nivells de parròquia, quart i veïnat, i quina feina tenia el llevador."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/com-funciona-tot.md"]}
{"id": "vida-quotidiana-com-funciona-tot/comprar-i-reclamar/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "He comprat un aparell durador que falla al cap de quatre mesos; explica’m la garantia mínima i què es presumeix sobre l’origen del defecte."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/comprar-i-reclamar.md"]}
{"id": "vida-quotidiana-com-funciona-tot/comprar-i-reclamar/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica’m l’ordre de solucions que preveu la protecció al consumidor quan un producte surt defectuós."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/comprar-i-reclamar.md"]}
{"id": "vida-quotidiana-com-funciona-tot/comprar-i-reclamar/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Descriu quan es pot desistir d’una compra a distància i què passa amb el termini si no t’han informat d’aquest dret."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/comprar-i-reclamar.md"]}
{"id": "vida-quotidiana-com-funciona-tot/comprar-i-reclamar/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Indica els passos per reclamar si un comerç no m’escolta i què pot fer l’autoritat de consum."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/comprar-i-reclamar.md"]}
{"id": "vida-quotidiana-com-funciona-tot/comprar-i-reclamar/05", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Aclareix la regla general sobre tornar una compra per canvi d’opinió i l’excepció de les vendes a distància."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/comprar-i-reclamar.md"]}
{"id": "vida-quotidiana-com-funciona-tot/comprar-i-reclamar/06", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica com protegeix la llei el consumidor quan la reparació es fa mentre encara corre la garantia."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/comprar-i-reclamar.md"]}
{"id": "vida-quotidiana-com-funciona-tot/conduir-a-andorra/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Vinc de fora amb cotxe; indica la velocitat màxima legal a les carreteres generals andorranes."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/conduir-a-andorra.md"]}
{"id": "vida-quotidiana-com-funciona-tot/conduir-a-andorra/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Indica quan són obligatoris els equipaments d’hivern i les dates en què es poden fer servir els pneumàtics de claus."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/conduir-a-andorra.md"]}
{"id": "vida-quotidiana-com-funciona-tot/conduir-a-andorra/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Al volant d’un vehicle per a passatgers, indica la taxa d’alcoholèmia i l’alternativa si no s’accepta el resultat de l’aparell."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/conduir-a-andorra.md"]}
{"id": "vida-quotidiana-com-funciona-tot/conduir-a-andorra/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica per què el codi demana reduir la velocitat en pendents, túnels o quan hi pot haver animals a la via."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/conduir-a-andorra.md"]}
{"id": "vida-quotidiana-com-funciona-tot/conduir-a-andorra/05", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Aclareix si una persona resident pot conduir amb matrícula estrangera i què passa amb un permís obtingut fora després de fer-se resident."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/conduir-a-andorra.md"]}
{"id": "vida-quotidiana-com-funciona-tot/conduir-a-andorra/06", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix la imatge del país que surt de les dades recents sobre vehicles per habitant i antiguitat mitjana del parc."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/conduir-a-andorra.md"]}
{"id": "vida-quotidiana-com-funciona-tot/que-costa-una-multa/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix l’escala general de multes de circulació i explica què substitueix el carnet per punts a Andorra."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/que-costa-una-multa.md"]}
{"id": "vida-quotidiana-com-funciona-tot/que-costa-una-multa/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Indica el descompte per pagament immediat d’una sanció de trànsit i el termini per presentar al·legacions."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/que-costa-una-multa.md"]}
{"id": "vida-quotidiana-com-funciona-tot/que-costa-una-multa/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica qui pot imposar les sancions de circulació i qui té l’exclusiva dels controls de velocitat i alcoholèmia."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/que-costa-una-multa.md"]}
{"id": "vida-quotidiana-com-funciona-tot/que-costa-una-multa/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Enumera les sancions especials que fan que el màxim pugui arribar als 3.000 euros."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/que-costa-una-multa.md"]}
{"id": "vida-quotidiana-com-funciona-tot/que-costa-una-multa/05", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Descriu en què consisteix la reincidència en infraccions greus o molt greus, segons el termini i el nombre de casos."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/que-costa-una-multa.md"]}
{"id": "vida-quotidiana-com-funciona-tot/que-costa-una-multa/06", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Si la suspensió del permís posa en risc la meva feina, explica si l’autoritat pot modular-ne l’aplicació."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/com-funciona-tot/que-costa-una-multa.md"]}
