{"id": "vida-quotidiana-convencions-socials/convencions-socials/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "En un país de prop de vuitanta mil habitants repartits en set parròquies, per què la sensació que tothom es coneix pot pesar en una conversa?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/convencions-socials.md"]}
{"id": "vida-quotidiana-convencions-socials/convencions-socials/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Aclareix què vol dir l’expressió «fer-se l’andorrà», sense convertir-la en una etiqueta sobre tot un poble."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/convencions-socials.md"]}
{"id": "vida-quotidiana-convencions-socials/la-tria-de-llengua/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica per què Montserrat Badia veia aprendre català com un gest d’integració i no com una necessitat per sobreviure."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/la-tria-de-llengua.md"]}
{"id": "vida-quotidiana-convencions-socials/la-tria-de-llengua/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Ajuda’m a entendre la idea d’integració en dues direccions que plantejava Badia, entre qui arriba i qui acull."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/la-tria-de-llengua.md"]}
{"id": "vida-quotidiana-convencions-socials/la-tria-de-llengua/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Descriu en quines situacions Badia proposava mantenir el català amb una persona desconeguda, i quina llibertat deixava en família o entre amistats."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/la-tria-de-llengua.md"]}
{"id": "vida-quotidiana-convencions-socials/la-tria-de-llengua/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica què pot comunicar, encara que es faci per cortesia, canviar al castellà amb algú que no coneixes."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/la-tria-de-llengua.md"]}
{"id": "vida-quotidiana-convencions-socials/landorra-dels-anys-cinquanta/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica qui era Sergi Mas i en quines circumstàncies va arribar a Andorra per primer cop."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/landorra-dels-anys-cinquanta.md"]}
{"id": "vida-quotidiana-convencions-socials/landorra-dels-anys-cinquanta/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix com descrivia Mas el tracte quotidià al carrer i què canviava quan entrava a la Casa Comuna o a la Casa de la Vall."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/landorra-dels-anys-cinquanta.md"]}
{"id": "vida-quotidiana-convencions-socials/landorra-dels-anys-cinquanta/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Descriu la confiança i la discreció que Mas recordava de la vida a Andorra als anys cinquanta."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/convencions-socials/landorra-dels-anys-cinquanta.md"]}
