{"id": "vida-quotidiana-geografia-mental/geografia-mental/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Què vol dir parlar de parròquies altes i baixes a Andorra, més enllà de l'altitud del mapa?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/vida-quotidiana/geografia-mental/geografia-mental.md"]}
