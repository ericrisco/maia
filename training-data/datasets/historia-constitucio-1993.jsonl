{"id": "historia-constitucio-1993/constitucio-1993/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica’m què va canviar el 14 de març de 1993 en la titularitat de la sobirania."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/historia/constitucio-1993/constitucio-1993.md"]}
{"id": "historia-constitucio-1993/constitucio-1993/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Del referèndum del 1993, quin percentatge va votar sí, i com canvia el càlcul si es compten només els vots vàlids?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/historia/constitucio-1993/constitucio-1993.md"]}
