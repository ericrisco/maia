{"id": "historia-constitucio-1993/vuit-dies-i-no-mes-de-quinze/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Quan es va signar la Constitució, quan es va publicar al BOPA i en quina data va entrar en vigor?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/historia/constitucio-1993/vuit-dies-i-no-mes-de-quinze.md"]}
{"id": "historia-constitucio-1993/vuit-dies-i-no-mes-de-quinze/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica’m com el preàmbul presenta la sobirania del poble i què diu la fórmula signada pels coprínceps."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/historia/constitucio-1993/vuit-dies-i-no-mes-de-quinze.md"]}
