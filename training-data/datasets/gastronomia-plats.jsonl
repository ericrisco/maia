{"id": "gastronomia-plats/plats/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Ajuda’m a distingir els plats andorrans dels que es comparteixen amb el Pirineu: quin criteri es proposa fer servir?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/gastronomia/plats/plats.md"]}
