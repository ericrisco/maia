{"id": "llengua-historia-de-la-llengua/costa-tant-dir-no-ho-se/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica per què els testimonis orals podien ajudar a respondre preguntes que els escrits no resolien."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/costa-tant-dir-no-ho-se.md"]}
{"id": "llengua-historia-de-la-llengua/costa-tant-dir-no-ho-se/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Fes-me un retrat de l’hostaler d’Andorra la Vella i de la varietat d’oficis que reunia al voltant de 1900."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/costa-tant-dir-no-ho-se.md"]}
{"id": "llengua-historia-de-la-llengua/costa-tant-dir-no-ho-se/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Quin problema hi havia quan una persona consultada no volia admetre que no sabia la resposta, i com es comprovaven els relats?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/costa-tant-dir-no-ho-se.md"]}
{"id": "llengua-historia-de-la-llengua/costa-tant-dir-no-ho-se/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Compara els dos tipus de persones consultades i què cadascuna podia explicar sobre el dret local."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/costa-tant-dir-no-ho-se.md"]}
{"id": "llengua-historia-de-la-llengua/costa-tant-dir-no-ho-se/05", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica què va revelar el moment en què un informant va obrir un llibret català per recordar els terminis."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/costa-tant-dir-no-ho-se.md"]}
{"id": "llengua-historia-de-la-llengua/costa-tant-dir-no-ho-se/06", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix quins arxius es van consultar i quan es van visitar els del Consell General."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/costa-tant-dir-no-ho-se.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica com la -r afegida a infinitius com «escriurer» serveix d’indici que la -r final no es pronunciava."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Què indiquen les formes «an-a qui» i «an-a ell» sobre la pronunciació d’aquella època?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix el canvi de la primera persona del present d’indicatiu entre els segles XVII i XVIII."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Aclareix per què escriure el plural femení amb -as no vol dir que es pronunciés «parròquias»."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/05", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Compara els usos de «dues» i «dos» al segle XVII, al XVIII i en català andorrà actual."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/06", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica quin auxiliar es feia servir per al perfet en verbs de moviment i com es veu en els exemples antics."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/per-que-el-manual-digest-no-diu-com-es-parlava/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica per què els llibres de registre més cuidat no eren els millors per saber com parlava la gent als segles XVII i XVIII."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/per-que-el-manual-digest-no-diu-com-es-parlava.md"]}
