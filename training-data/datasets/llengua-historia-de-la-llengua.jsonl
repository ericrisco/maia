{"id": "llengua-historia-de-la-llengua/relacio/03", "type": "relacio", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Relaciona l’ús de llibres de registre acurat amb la manera com una persona podia confondre el dret català amb el costum andorrà."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/costa-tant-dir-no-ho-se.md", "docs/temes/llengua/historia-de-la-llengua/per-que-el-manual-digest-no-diu-com-es-parlava.md"]}
