{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Explica com la -r afegida a infinitius com «escriurer» serveix d’indici que la -r final no es pronunciava."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Què indiquen les formes «an-a qui» i «an-a ell» sobre la pronunciació d’aquella època?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix el canvi de la primera persona del present d’indicatiu entre els segles XVII i XVIII."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
{"id": "llengua-historia-de-la-llengua/lerra-que-ja-no-sonava/04", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Aclareix per què escriure el plural femení amb -as no vol dir que es pronunciés «parròquias»."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/llengua/historia-de-la-llengua/lerra-que-ja-no-sonava.md"]}
