{"id": "historia-democratitzacio/democratitzacio/01", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Em costa distingir sufragi actiu i passiu: explica’m què permetia cadascun i en quins anys es va reconèixer a les dones."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/historia/democratitzacio/democratitzacio.md"]}
{"id": "historia-democratitzacio/democratitzacio/02", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Abans que votessin els ciutadans, qui participava en política i quin pes tenien els caps de casa després de la Nova Reforma?"}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/historia/democratitzacio/democratitzacio.md"]}
{"id": "historia-democratitzacio/democratitzacio/03", "type": "directa", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Resumeix com es van modificar l’edat de vot i el sufragi masculí entre 1933 i 1970."}, {"role": "assistant", "content": ""}], "documents": ["docs/temes/historia/democratitzacio/democratitzacio.md"]}
