{
  "openapi": "3.1.0",
  "info": {
    "title": "MAIA inference API",
    "description": "OpenAI-compatible chat completions over MAIA, with Andorran-corpus RAG. Responses carry a `sources` array; passages under a no-redistribute licence are cited but not quoted.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Model **and** index.\n\nA loaded model with an empty collection answers every question with *\"no ho sé\"* while\nreturning 200, so a health check that only looked at the process would be green on a broken\nsystem.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/rag/search": {
      "post": {
        "summary": "Search",
        "description": "Retrieval without generation.\n\nRestricted text is ``null`` rather than absent, so a client can tell *\"this chunk exists and\nyou may not see its text\"* from *\"there is no such chunk\"*.",
        "operationId": "search_rag_search_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Chat",
        "description": "OpenAI-compatible chat completions, with RAG on by default.",
        "operationId": "chat_v1_chat_completions_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "maia-12b"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "minItems": 1,
            "title": "Messages"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 512
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "default": 0.3
          },
          "top_p": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Top P",
            "default": 1.0
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "rag": {
            "type": "boolean",
            "title": "Rag",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest",
        "description": "``POST /v1/chat/completions``, OpenAI-compatible.\n\nThe unused fields are here on purpose: an OpenAI client sends them, and rejecting a request for\ncarrying ``top_p`` would break the compatibility that is the whole point. They are accepted and,\nwhere this service cannot honour them, ignored — which is what an OpenAI-compatible proxy does."
      },
      "ChatResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "const": "chat.completion",
            "title": "Object",
            "default": "chat.completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/Choice"
            },
            "type": "array",
            "title": "Choices"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "choices"
        ],
        "title": "ChatResponse",
        "description": "``POST /v1/chat/completions`` response, OpenAI-compatible plus ``sources``."
      },
      "Choice": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index",
            "default": 0
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "stop",
              "length"
            ],
            "title": "Finish Reason",
            "default": "stop"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Choice",
        "description": "OpenAI's choice envelope."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "model_ready": {
            "type": "boolean",
            "title": "Model Ready"
          },
          "index_ready": {
            "type": "boolean",
            "title": "Index Ready"
          },
          "indexed_chunks": {
            "type": "integer",
            "title": "Indexed Chunks"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "model",
          "model_ready",
          "index_ready",
          "indexed_chunks"
        ],
        "title": "Health",
        "description": "``GET /health`` — model **and** index."
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message",
        "description": "One chat message, in OpenAI's shape."
      },
      "SearchHit": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chunk_id",
          "score",
          "text",
          "source"
        ],
        "title": "SearchHit",
        "description": "One retrieved chunk, as the debug endpoint returns it."
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "description": "``POST /rag/search`` — retrieval without generation, for debugging."
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "hits": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "type": "array",
            "title": "Hits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "hits"
        ],
        "title": "SearchResponse",
        "description": "``POST /rag/search`` response."
      },
      "Source": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "llei": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llei"
          },
          "article": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article"
          },
          "consolidacio_data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consolidacio Data"
          },
          "text_withheld": {
            "type": "boolean",
            "title": "Text Withheld",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "Source",
        "description": "One citation. ``llei``/``article``/``consolidacio_data`` are legal-only."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
